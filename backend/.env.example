# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=your_very_long_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# =====================================================
# IBM watsonx.ai Configuration (REQUIRED for AI)
# =====================================================
# 1. Create IBM Cloud account: https://cloud.ibm.com/registration
# 2. Create watsonx.ai project: https://dataplatform.cloud.ibm.com/
# 3. Copy your Project ID from project settings
# 4. Create API key: https://cloud.ibm.com/iam/apikeys
#
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model options: ibm/granite-3-8b-instruct (Lite tier), ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# =====================================================
# Tavily Web Search (RECOMMENDED for live research)
# =====================================================
# Free tier: 1000 searches/month — no credit card required
# Sign up: https://tavily.com/
# Without this, live web research will use DuckDuckGo fallback
#
TAVILY_API_KEY=your_tavily_api_key_here

# Logging
LOG_LEVEL=info
